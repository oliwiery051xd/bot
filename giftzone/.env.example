# MONSTAL — WSZYSTKIE TWOJE DANE W JEDNYM MIEJSCU
# Skopiuj ten plik do .env i uzupełnij poniższe pola. Nie publikuj .env.

# 1. Token z @BotFather (sekret).
BOT_TOKEN=
# 2. TWOJE liczbowe Telegram ID. Dla kilku administratorów oddziel je przecinkami.
# Nigdy username ani ID grupy. Puste pole = brak dostępu do /admin.
ADMIN_IDS=
# 3. Twój nick do kontaktu BLIK, z @ lub bez. Możesz podać go później.
MERCHANT_TELEGRAM_USERNAME=

# 4. Publiczne adresy odbiorcze dla wpłat automatycznie wyświetlanych w bocie.
# Nigdy klucz prywatny, seed phrase lub hasło. Puste pole wyłącza daną walutę.
CRYPTO_BTC_ADDRESS=
CRYPTO_ETH_ADDRESS=
# USDC wyłącznie Ethereum mainnet / ERC-20, nie Solana/Base/Polygon.
CRYPTO_USDC_ADDRESS=
CRYPTO_SOL_ADDRESS=

# 5. Opcjonalny klucz CoinGecko Demo API — zostaw pusty, jeśli API działa bez niego.
COINGECKO_API_KEY=

# GOTOWE USTAWIENIA — nie musisz ich zmieniać, aby włączyć automat kursów.
CRYPTO_AUTO_RATES=true
# current = kurs rynkowy; low_24h = minimum z ostatnich 24 godzin.
RATE_PRICE_MODE=current
# 300 = odświeżanie co 5 minut. Aktualizacja raz dziennie: 86400.
RATE_REFRESH_SECONDS=300
# Starsze kursy nie są używane, nawet gdy API nie działa (maks. 24 godziny).
RATE_MAX_AGE_SECONDS=86400

DATABASE_URL=sqlite+aiosqlite:///./monstal.db
# Docker używa /data/monstal.db; opcjonalnie ustaw inny DATABASE_URL_DOCKER.
DEMO_MODE=false
REFERRAL_BONUS_GROSZE=1000
LOG_LEVEL=INFO

# Klucz szyfrujący imię, telefon i adres zamówień. Utwórz raz: python -m app.generate_customer_key
CUSTOMER_DATA_KEY=
